rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                            && request.auth.uid == userId;
      allow delete: if false;

      match /devices/{deviceId} {
        allow read, create, update, delete: if request.auth != null
                                            && request.auth.uid == userId;
      }
      match /treeTags/{tagId} {
         allow read: if request.auth != null;

         allow create: if request.auth != null
                       && request.resource.data.treeOwnerId == userId
                       && request.resource.data.authorId == request.auth.uid;

         allow delete: if request.auth != null
                       && (
                         request.auth.uid == userId
                         || resource.data.authorId == request.auth.uid
                       );

         allow update: if false;
      }


      match /timeCapsules/{capsuleId} {
        allow read: if request.auth != null
                    && request.auth.uid == userId;

        allow create: if request.auth != null
                      && request.auth.uid == userId
                      && request.resource.data.keys().hasOnly([
                        'title',
                        'content',
                        'createdAt',
                        'unlockDate'
                      ])
                      && request.resource.data.title is string
                      && request.resource.data.content is string
                      && request.resource.data.createdAt is timestamp
                      && request.resource.data.unlockDate is timestamp;

        allow update: if false;

        allow delete: if request.auth != null
                      && request.auth.uid == userId;
      }

      match /contacts/{contactId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
                      && request.resource.data.uid == contactId
                      && request.resource.data.keys()
                         .hasOnly(['uid', 'requestId', 'createdAt'])
                      && request.auth.uid ==
                         getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.receiverId
                      && getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.status == 'accepted'
                      && userId in
                         getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.memberIds
                      && contactId in
                         getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.memberIds;
        allow update: if false;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      match /contactPreferences/{contactId} {
        allow read, create, update, delete: if request.auth != null
                                            && request.auth.uid == userId;
      }

      match /blockedUsers/{blockedUserId} {
        allow read, create, update, delete: if request.auth != null
                                            && request.auth.uid == userId;
      }

      match /savedMessages/{savedMessageId} {
        allow read, create, update, delete: if request.auth != null
                                            && request.auth.uid == userId;
      }
    }

    match /friendRequests/{requestId} {
      allow get: if request.auth != null
                 && request.auth.uid in resource.data.memberIds;

      allow list: if request.auth != null
                   && request.auth.uid in resource.data.memberIds;
      allow create: if request.auth != null
                    && request.resource.data.senderId == request.auth.uid
                    && request.resource.data.receiverId != request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.memberIds.size() == 2
                    && request.resource.data.senderId in request.resource.data.memberIds
                    && request.resource.data.receiverId in request.resource.data.memberIds
                    && request.resource.data.keys().hasOnly([
                      'memberIds', 'senderId', 'receiverId', 'status',
                      'createdAt', 'respondedAt'
                    ]);
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.receiverId
                    && resource.data.status == 'pending'
                    && request.resource.data.status in ['accepted', 'rejected']
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['status', 'respondedAt']);
      allow delete: if false;
    }

    match /usernames/{username} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.username == username
                    && request.resource.data.keys().hasOnly([
                      'uid', 'username', 'createdAt'
                    ]);
      allow update, delete: if false;
    }

    match /userReports/{reportId} {
      allow create: if request.auth != null
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.reportedUserId != request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.keys().hasOnly([
                      'reporterId', 'reportedUserId', 'reason', 'status',
                      'createdAt'
                    ]);
      allow read, update, delete: if false;
    }

    match /conversations/{conversationId} {
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.memberIds
                    && request.resource.data.memberIds.size() == 2;
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.memberIds;
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.memberIds
                    && request.resource.data.memberIds == resource.data.memberIds;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null
                    && request.auth.uid in
                       get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds;
        allow create: if request.auth != null
                      && request.resource.data.senderId == request.auth.uid
                      && request.auth.uid in
                         getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds;
        allow update: if request.auth != null && (
          (resource.data.senderId == request.auth.uid
           && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['text', 'editedAt', 'isDeleted']))
          ||
          (resource.data.receiverId == request.auth.uid
           && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['readAt']))
          ||
          (request.auth.uid in
             get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds
           && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['reactions', 'hiddenFor']))
        );
        allow delete: if false;
      }

      match /typing/{userId} {
        allow read: if request.auth != null
                    && request.auth.uid in
                       get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds;
        allow create, update: if request.auth != null
                              && request.auth.uid == userId
                              && request.auth.uid in
                                 get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds;
        allow delete: if false;
      }
    }

    match /groups/{groupId} {
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid
                    && request.auth.uid in request.resource.data.memberIds
                    && request.resource.data.memberIds.size() >= 2;
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.memberIds;
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.memberIds
                    && (
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['lastMessage', 'lastSenderId', 'updatedAt', 'unreadCounts'])
                      || request.auth.uid == resource.data.ownerId
                      || (
                        request.auth.uid in resource.data.adminIds
                        && request.resource.data.ownerId == resource.data.ownerId
                        && request.resource.data.adminIds == resource.data.adminIds
                      )
                      || (
                        request.resource.data.ownerId == resource.data.ownerId
                        && (
                          request.resource.data.adminIds == resource.data.adminIds
                          || request.resource.data.adminIds
                             == resource.data.adminIds.removeAll([request.auth.uid])
                        )
                        && request.resource.data.memberIds
                           == resource.data.memberIds.removeAll([request.auth.uid])
                      )
                    );
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.ownerId;

      match /messages/{messageId} {
        allow read: if request.auth != null
                    && request.auth.uid in
                       get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        allow create: if request.auth != null
                      && request.resource.data.senderId == request.auth.uid
                      && request.auth.uid in
                         getAfter(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        allow update: if request.auth != null && (
          (resource.data.senderId == request.auth.uid
           && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['text', 'editedAt', 'isDeleted']))
          ||
          (request.auth.uid in
             get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds
           && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['readBy', 'reactions']))
        );
        allow delete: if false;
      }
    }

    // Phase 73: shared pets
    match /sharedPets/{petId} {
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.memberIds;

      allow create: if request.auth != null
                    && request.resource.data.memberIds is list
                    && request.resource.data.memberIds.size() == 2
                    && request.auth.uid in request.resource.data.memberIds;

      allow update: if request.auth != null
                    && request.auth.uid in resource.data.memberIds
                    && request.resource.data.memberIds == resource.data.memberIds;

      allow delete: if request.auth != null
                    && request.auth.uid in resource.data.memberIds;
    }



    // Phase 106: one-to-one call signaling.
    match /calls/{callId} {
      function callParticipant() {
        return request.auth != null
               && (
                 request.auth.uid == resource.data.callerId
                 || request.auth.uid == resource.data.calleeId
               );
      }

      function incomingCallParticipant() {
        return request.auth != null
               && (
                 request.auth.uid == request.resource.data.callerId
                 || request.auth.uid == request.resource.data.calleeId
               );
      }

      allow get: if request.auth != null
                  && request.auth.uid in resource.data.memberIds;

          // IncomingCallListener:
      // where('calleeId', isEqualTo: currentUser.uid)
      allow list: if request.auth != null
                  && resource.data.calleeId == request.auth.uid;

      allow create: if request.auth != null
                    && request.resource.data.callerId == request.auth.uid
                    && request.resource.data.calleeId != request.auth.uid
                    && request.resource.data.type == 'audio'
                    && request.resource.data.status == 'ringing'
                    && request.resource.data.memberIds is list
                    && request.resource.data.memberIds.size() == 2
                    && request.resource.data.callerId in request.resource.data.memberIds
                    && request.resource.data.calleeId in request.resource.data.memberIds;

      allow update: if callParticipant()
                    && incomingCallParticipant()
                    && request.resource.data.callerId == resource.data.callerId
                    && request.resource.data.calleeId == resource.data.calleeId
                    && request.resource.data.memberIds == resource.data.memberIds
                    && request.resource.data.type == resource.data.type;

      allow delete: if false;

      match /callerCandidates/{candidateId} {
        function parentCall() {
          return get(/databases/$(database)/documents/calls/$(callId)).data;
        }

        allow read: if request.auth != null
                    && (
                      request.auth.uid == parentCall().callerId
                      || request.auth.uid == parentCall().calleeId
                    );

        allow create: if request.auth != null
                      && request.auth.uid == parentCall().callerId;

        allow update, delete: if false;
      }

      match /calleeCandidates/{candidateId} {
        function parentCall() {
          return get(/databases/$(database)/documents/calls/$(callId)).data;
        }

        allow read: if request.auth != null
                    && (
                      request.auth.uid == parentCall().callerId
                      || request.auth.uid == parentCall().calleeId
                    );

        allow create: if request.auth != null
                      && request.auth.uid == parentCall().calleeId;

        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
